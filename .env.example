# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Optional managed PostgreSQL & Auth endpoint for ERPThrive.
# Required for live Supabase PostgreSQL and Auth connection.
# Example: "https://your-project.supabase.co"
SUPABASE_URL="https://nuwghxiiohlhdnhbkacm.supabase.co"
VITE_SUPABASE_URL="https://nuwghxiiohlhdnhbkacm.supabase.co"

# SUPABASE_ANON_KEY: Client-side anonymous public key for Supabase Auth.
SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SUPABASE_SERVICE_ROLE_KEY: Trusted server-side secret key for admin database migrations and operations.
# NEVER expose this key to client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
